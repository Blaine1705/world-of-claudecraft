# World of ClaudeCraft uses pnpm's content-addressable store so many git worktrees
# share one download cache. Install with: corepack enable && pnpm install
# (or npm i -g pnpm@10.14.0 when corepack is unavailable, e.g. some nvm builds).
#
# Hoisted node_modules: many scripts and asset exporters import transitive
# packages (@gltf-transform/core, meshoptimizer, ...) that npm used to hoist.
# node-linker=hoisted keeps a flat layout like npm while still using the shared
# content-addressable store (the multi-worktree win).
node-linker=hoisted
# auto-install-peers matches the imported lockfile settings and keeps the
# TypeScript dual-alias + svelte-check tree resolvable.
auto-install-peers=true
# Do not strict-fail on unmet peers from optional wallet/solana trees that
# request typescript@^5 while this repo pins the TS6 JS API wrapper for svelte-check.
strict-peer-dependencies=false
